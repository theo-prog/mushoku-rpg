{
  "type": "object",
  "properties": {
    "data_mundo": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "local_atual": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_]*$"
    },
    "clima": {
      "type": "string",
      "minLength": 1
    },
    "relogios": {
      "type": "object",
      "properties": {
        "descida": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "coroa_silenciosa": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "purificacao": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "titulo_vago": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "migracao": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "required": [
        "descida",
        "coroa_silenciosa",
        "purificacao",
        "titulo_vago",
        "migracao"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "uniqueItems": true
    },
    "noticias_recentes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "texto": {
            "type": "string",
            "minLength": 1
          },
          "evento_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9_]*$"
          },
          "local_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9_]*$"
          }
        },
        "required": [
          "data",
          "texto"
        ]
      }
    },
    "sessao": {
      "type": "integer",
      "minimum": 0
    },
    "abertura": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_]*$"
    }
  },
  "required": [
    "data_mundo",
    "local_atual",
    "clima",
    "relogios",
    "flags",
    "noticias_recentes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estado do mundo"
}
